TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=platform
TEMPORAL_TASK_QUEUE_MEMORY=memory-consolidation
LOG_LEVEL=INFO
PLATFORM_API_BASE_URL=http://localhost:5120
# One shared Bearer token for every worker that calls Platform /api/internal/v1/* (memory consolidation,
# memory context, side-learning, …). Must match PlatformWorkers:ServiceToken on the .NET API host.
# Preferred name; MEMORY_WORKER_SERVICE_TOKEN is an accepted legacy alias (same value, not memory-only).
PLATFORM_INTERNAL_SERVICE_TOKEN=
CONSOLIDATION_PRIMARY_USER_ID=1
# OpenAI-compatible API (used for side-learning topic proposals).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Side-learning Stage B (session + dedicated context teaching call). Use a capable model;
# when unset, falls back to OPENAI_MODEL. Recommended: gpt-4o or your strongest available model.
OPENAI_SIDE_LEARNING_SESSION_MODEL=gpt-4o
